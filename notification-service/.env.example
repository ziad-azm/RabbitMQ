# Notification Service – copy to .env
# These values are for running the service locally (npm run start:dev).
# Under Docker Compose, RABBITMQ_URL is overridden to use the
# "rabbitmq" container hostname instead of localhost.

PORT=3002
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# How many times a failed message is retried before it is moved
# to notification.dead.queue.
MAX_RETRY_ATTEMPTS=3

# TTL on notification.retry.queue – the delay between retries, in ms.
RETRY_DELAY_MS=10000

# Set to true to force sendWelcomeEmail() to throw, so you can watch
# the retry + DLQ flow. Fails the first 3 attempts per userId.
SIMULATE_EMAIL_FAILURE=false
